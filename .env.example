# Server Configuration (On Render, PORT is assigned dynamically)
PORT=5000
NODE_ENV=production

# JWT Authentication Secret (Use a strong random string in production)
JWT_SECRET=prepvoice_ai_jwt_super_secret_key_production_2026

# MongoDB Connection String (e.g. MongoDB Atlas free tier URI)
# If left empty or invalid, the app runs in resilient in-memory mock store mode automatically.
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/prepvoice?retryWrites=true&w=majority

# AI Service Engine
# Set to 'internal' to use the built-in fast Node NLP engine (recommended on Render).
# If you deploy a separate Python AI microservice, set its live URL here (e.g. https://your-python-service.onrender.com).
AI_SERVICE_URL=internal

# CORS Allowed Origins
# Comma-separated list of allowed frontend domains (e.g. https://your-app.vercel.app).
# Use '*' or leave empty to allow all origins.
ALLOWED_ORIGINS=*
